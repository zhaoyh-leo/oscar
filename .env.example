# ---- OSCAR secrets ----
# Copy this file to `.env` in the project root and fill in the key for the
# provider you use. Secrets are ONLY read from the environment / `.env`;
# they must never be placed in config.yaml or committed code.
#
# provider "deepseek" (default)      -> DEEPSEEK_API_KEY
# provider "openai"                  -> OPENAI_API_KEY
# provider "openai_compatible"       -> OPENAI_COMPATIBLE_API_KEY
# provider "anthropic"               -> ANTHROPIC_API_KEY

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
ANTHROPIC_API_KEY=

# Optional: Hugging Face mirror endpoint for scripts/download_models.py
# in regions where huggingface.co is unreachable:
# HF_ENDPOINT=https://hf-mirror.com
